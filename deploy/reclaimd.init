#!/bin/sh /etc/rc.common
# procd service for reclaimd on OpenWrt.
#
# Install to /etc/init.d/reclaimd (mode 0755), binary to /usr/bin/reclaimd.
# Read the JSON log with: logread -e reclaimd
START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/reclaimd
CONF=/etc/reclaimd/config.json

# NOT /var/lib. On OpenWrt /var is a symlink to /tmp, so state written there is
# lost at every reboot -- taking the schedule and, far worse, the post-dropout
# suppression window with it. The only symptom would be a daemon that never
# quite seems to work. /root is on the overlay and persists.
STATE=/root/reclaimd

start_service() {
    procd_open_instance
    procd_set_param command "$PROG" daemon -state-dir "$STATE"
    [ -f "$CONF" ] && procd_append_param command -config "$CONF"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile /var/run/reclaimd.pid
    # The scanner is deliberately the lowest-priority thing on the box.
    procd_set_param nice 10
    procd_set_param file "$CONF"
    # respawn threshold / timeout / retries; 0 retries means keep trying.
    procd_set_param respawn 3600 5 0
    # A single pread can block for the controller's ~1.8s watchdog hang, and the
    # SCSI layer's own timeout is 30s. procd's default 5s would SIGKILL us
    # mid-syscall, which is exactly when clean state matters most.
    procd_set_param term_timeout 45
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "reclaimd"
}
