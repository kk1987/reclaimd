# Optional. Serves the status page through an nginx that is already on the box,
# so the daemon can stay on 127.0.0.1 and needs no config of its own: no
# listen_addr, no ui_token, no restart.
#
# Install to /etc/nginx/conf.d/reclaimd.locations. The extension matters: on
# OpenWrt the generated uci.conf includes conf.d/*.locations inside the default
# `_lan` server, so these locations land there automatically. A file named
# *.conf is included in http{} instead and would need its own server block.
#
#   /etc/init.d/nginx reload   ->   https://<router>/reclaimd/
#
# The `include restrict_locally` lines are what let this same file be included
# by hand into a server block that faces the internet, say a vhost with a real
# certificate, without publishing the page along with it. That file ships with
# OpenWrt's nginx and allows RFC1918 and link-local only. On a distro that does
# not have it, drop the includes or write the equivalent allow/deny rules.
#
# Behind a gateway that does NAT reflection, check which address the proxy
# actually sees for LAN clients before trusting this: a reflected connection is
# commonly SNATed to the gateway's own LAN address, which passes, while traffic
# arriving from the internet keeps its real source address, which does not.

location = /reclaimd { return 301 /reclaimd/; }

# The event stream stays open for the length of a pass, which on a slow stick
# is hours. Buffering it would hold every progress update until the pass ended,
# and a running pass is the one time the page is worth watching.
location = /reclaimd/api/v1/stream {
    include restrict_locally;

    proxy_pass http://127.0.0.1:8099/api/v1/stream;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_buffering off;
    chunked_transfer_encoding off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
}

# The trailing slash on proxy_pass strips the /reclaimd/ prefix, and the page
# resolves its own API base from where it was served, so the app does not need
# to know it is mounted under one.
location /reclaimd/ {
    include restrict_locally;

    proxy_pass http://127.0.0.1:8099/;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_read_timeout 60s;
}
